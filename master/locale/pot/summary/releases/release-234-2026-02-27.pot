msgid "The primop returns an error"
msgstr ""

#: source/release-notes/rl-2.34.md:192
msgid "Force the thunk again"
msgstr ""

#: source/release-notes/rl-2.34.md:193
msgid "The primop returns a value"
msgstr ""

#: source/release-notes/rl-2.34.md:194
msgid "The thunk evaluated successfully"
msgstr ""

