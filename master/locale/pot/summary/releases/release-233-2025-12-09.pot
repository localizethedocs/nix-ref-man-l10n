msgid "String-based hash values (e.g., `\"narHash\": \"sha256:FePFYIlM...\"`)"
msgstr ""

#: source/release-notes/rl-2.33.md:132
msgid ""
"String-based content addresses (e.g., `\"ca\": \"fixed:r:sha256:1abc...\"`)"
msgstr ""

#: source/release-notes/rl-2.33.md:133
msgid ""
"Full store paths for map keys and references (e.g., `\"/nix/store/abc...-"
"foo\"`)"
msgstr ""

#: source/release-notes/rl-2.33.md:134
msgid "Now includes `\"storeDir\"` field at the top level"
msgstr ""

#: source/release-notes/rl-2.33.md:136
msgid "Version 2 (`--json-format 2`)"
msgstr ""

#: source/release-notes/rl-2.33.md:138
msgid ""
"The new structured format follows the [data modeling guidelines](../"
"development/data-modeling.md) with the following changes:"
msgstr ""

#: source/release-notes/rl-2.33.md:140 source/release-notes/rl-2.33.md:183
msgid "**Nested structure with top-level metadata**:"
msgstr ""

#: source/release-notes/rl-2.33.md:142
