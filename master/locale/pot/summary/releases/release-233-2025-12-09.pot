msgid "Old: `\"ca\": \"fixed:r:sha256:1abc...\"`"
msgstr ""

#: source/release-notes/rl-2.33.md:164
msgid ""
"New: `\"ca\": {\"method\": \"nar\", \"hash\": \"sha256-"
"ungWv48Bz+pBQUDeXa4iI7ADYaOWF3qctBD/YfIAFa0=\"}`"
msgstr ""

#: source/release-notes/rl-2.33.md:165
msgid "Still `null` values for input-addressed store objects"
msgstr ""

#: source/release-notes/rl-2.33.md:167
