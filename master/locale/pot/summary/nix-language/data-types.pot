#: source/language/types.md:1
msgid "Data Types"
msgstr ""

#: source/language/types.md:3
msgid "Every value in the Nix language has one of the following types:"
msgstr ""

#: source/language/types.md:5
msgid "[Integer](#type-int)"
msgstr ""

#: source/language/types.md:6
msgid "[Float](#type-float)"
msgstr ""

#: source/language/types.md:7
msgid "[Boolean](#type-bool)"
msgstr ""

#: source/language/types.md:8
msgid "[String](#type-string)"
msgstr ""

#: source/language/types.md:9
msgid "[Path](#type-path)"
msgstr ""

#: source/language/types.md:10
msgid "[Null](#type-null)"
msgstr ""

#: source/language/types.md:11
msgid "[Attribute set](#type-attrs)"
msgstr ""

#: source/language/types.md:12
msgid "[List](#type-list)"
msgstr ""

#: source/language/types.md:13
