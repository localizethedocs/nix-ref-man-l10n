#: source/command-ref/new-cli/nix3-store-path-from-hash-part.md:6
msgid "Name"
msgstr ""

#: source/command-ref/new-cli/nix3-store-path-from-hash-part.md:8
msgid "`nix store path-from-hash-part` - get a store path from its hash part"
msgstr ""

#: source/command-ref/new-cli/nix3-store-path-from-hash-part.md:10
msgid "Synopsis"
msgstr ""

#: source/command-ref/new-cli/nix3-store-path-from-hash-part.md:12
msgid "`nix store path-from-hash-part` \\[_option_...\\] _hash-part_"
msgstr ""

#: source/command-ref/new-cli/nix3-store-path-from-hash-part.md:14
msgid "Examples"
msgstr ""

#: source/command-ref/new-cli/nix3-store-path-from-hash-part.md:16
msgid "Return the full store path with the given hash part:"
msgstr ""

#: source/command-ref/new-cli/nix3-store-path-from-hash-part.md:18
msgid ""
"```console\n"
"# nix store path-from-hash-part --store https://cache.nixos.org/ "
"qbhyj3blxpw2i6pb7c6grc9185nbnpvy\n"
"/nix/store/qbhyj3blxpw2i6pb7c6grc9185nbnpvy-hello-2.10\n"
"```"
msgstr ""

#: source/command-ref/new-cli/nix3-store-path-from-hash-part.md:23
msgid "Description"
msgstr ""

#: source/command-ref/new-cli/nix3-store-path-from-hash-part.md:25
msgid ""
"Given the hash part of a store path (that is, the 32 characters following `/"
"nix/store/`), return the full store path. This is primarily useful in the "
"implementation of binary caches, where a request for a `.narinfo` file only "
"supplies the hash part (e.g. `https://cache.nixos.org/"
"qbhyj3blxpw2i6pb7c6grc9185nbnpvy.narinfo`)."
msgstr ""

