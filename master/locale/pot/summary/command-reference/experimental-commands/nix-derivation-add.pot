msgstr ""

#: source/command-ref/new-cli/nix3-derivation-add.md:6
msgid "Name"
msgstr ""

#: source/command-ref/new-cli/nix3-derivation-add.md:8
msgid "`nix derivation add` - add a store derivation"
msgstr ""

#: source/command-ref/new-cli/nix3-derivation-add.md:10
msgid "Synopsis"
msgstr ""

#: source/command-ref/new-cli/nix3-derivation-add.md:12
