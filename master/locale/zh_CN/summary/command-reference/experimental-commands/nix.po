msgstr ""

#: source/command-ref/new-cli/nix.md:362
msgid "\"$@\""
msgstr ""

#: source/command-ref/new-cli/nix.md:365
msgid ""
"or with cascading interpreters. Note that the `#! nix` lines don't need to "
"follow after the first line, to accommodate other interpreters."
msgstr ""

#: source/command-ref/new-cli/nix.md:367
msgid ""
"````\n"
"#!/usr/bin/env nix\n"
"//! ```cargo\n"
"//! [dependencies]\n"
"//! time = \"0.1.25\"\n"
"//! ```\n"
"/*\n"
"#!nix shell nixpkgs#rustc nixpkgs#rust-script nixpkgs#cargo --command rust-"
"script\n"
"*/\n"
"fn main() {\n"
"    for argument in std::env::args().skip(1) {\n"
"        println!(\"{}\", argument);\n"
"    };\n"
"    println!(\"{}\", std::env::var(\"HOME\").expect(\"\"));\n"
"    println!(\"{}\", time::now().rfc822z());\n"
"}\n"
"// vim: ft=rust\n"
"````"
msgstr ""

