#: source/store/types/http-binary-cache-store.md:1
msgid "HTTP Binary Cache Store"
msgstr ""

#: source/store/types/http-binary-cache-store.md:3
msgid "**Store URL format**: `http://...`, `https://...`"
msgstr ""

#: source/store/types/http-binary-cache-store.md:5
msgid ""
"This store allows a [binary cache](../../protocols/binary-cache/index.md) to "
"be accessed via the HTTP protocol."
msgstr ""

#: source/store/types/http-binary-cache-store.md:8
msgid "Settings"
msgstr ""

#: source/store/types/http-binary-cache-store.md:10
msgid ""
"<span id=\"store-http-binary-cache-store-compression\">[`compression`]"
"(#store-http-binary-cache-store-compression)</span>"
msgstr ""

#: source/store/types/http-binary-cache-store.md:12
msgid ""
"NAR compression method. One of: `xz`, `bzip2`, `gzip`, `zstd`, `none`, `br`, "
"`compress`, `grzip`, `lrzip`, `lz4`, `lzip`, `lzma` or `lzop`. To use a "
"particular compression method Nix has to be built with a version of "
"libarchive that natively supports that compression algorithm."
msgstr ""

#: source/store/types/http-binary-cache-store.md:15
msgid "**Default:** `xz`"
msgstr ""

#: source/store/types/http-binary-cache-store.md:17
msgid ""
"<span id=\"store-http-binary-cache-store-compression-level\">[`compression-"
"level`](#store-http-binary-cache-store-compression-level)</span>"
msgstr ""

#: source/store/types/http-binary-cache-store.md:19
msgid ""
"The _preset level_ to be used when compressing NARs. The meaning and "
"accepted values depend on the compression method selected. `-1` specifies "
"that the default compression level should be used."
msgstr ""

#: source/store/types/http-binary-cache-store.md:23
msgid "**Default:** `-1`"
msgstr ""

#: source/store/types/http-binary-cache-store.md:25
msgid ""
"<span id=\"store-http-binary-cache-store-index-debug-info\">[`index-debug-"
"info`](#store-http-binary-cache-store-index-debug-info)</span>"
msgstr ""

#: source/store/types/http-binary-cache-store.md:27
msgid ""
"Whether to index DWARF debug info files by build ID. This allows [`dwarffs`]"
"(https://github.com/edolstra/dwarffs) to fetch debug info on demand"
msgstr ""

#: source/store/types/http-binary-cache-store.md:30
#: source/store/types/http-binary-cache-store.md:64
#: source/store/types/http-binary-cache-store.md:152
#: source/store/types/http-binary-cache-store.md:158
#: source/store/types/http-binary-cache-store.md:164
msgid "**Default:** `false`"
msgstr ""

#: source/store/types/http-binary-cache-store.md:32
msgid ""
"<span id=\"store-http-binary-cache-store-local-nar-cache\">[`local-nar-"
"cache`](#store-http-binary-cache-store-local-nar-cache)</span>"
msgstr ""

#: source/store/types/http-binary-cache-store.md:34
msgid ""
"Path to a local cache of NARs fetched from this binary cache, used by "
"commands such as `nix store cat`."
msgstr ""

#: source/store/types/http-binary-cache-store.md:36
#: source/store/types/http-binary-cache-store.md:44
#: source/store/types/http-binary-cache-store.md:50
#: source/store/types/http-binary-cache-store.md:56
#: source/store/types/http-binary-cache-store.md:107
#: source/store/types/http-binary-cache-store.md:137
#: source/store/types/http-binary-cache-store.md:143
msgid "**Default:** \\``"
msgstr ""

#: source/store/types/http-binary-cache-store.md:38
msgid ""
"<span id=\"store-http-binary-cache-store-log-compression\">[`log-"
"compression`](#store-http-binary-cache-store-log-compression)</span>"
msgstr ""

#: source/store/types/http-binary-cache-store.md:40
msgid ""
"Compression method for `log/*` files. It is recommended to use a compression "
"method supported by most web browsers (e.g. `brotli`)."
msgstr ""

#: source/store/types/http-binary-cache-store.md:46
msgid ""
"<span id=\"store-http-binary-cache-store-ls-compression\">[`ls-compression`]"
"(#store-http-binary-cache-store-ls-compression)</span>"
msgstr ""

#: source/store/types/http-binary-cache-store.md:48
msgid "Compression method for `.ls` files."
msgstr ""

#: source/store/types/http-binary-cache-store.md:52
msgid ""
"<span id=\"store-http-binary-cache-store-narinfo-compression\">[`narinfo-"
"compression`](#store-http-binary-cache-store-narinfo-compression)</span>"
msgstr ""

#: source/store/types/http-binary-cache-store.md:54
msgid "Compression method for `.narinfo` files."
msgstr ""

#: source/store/types/http-binary-cache-store.md:58
msgid ""
"<span id=\"store-http-binary-cache-store-parallel-compression\">[`parallel-"
"compression`](#store-http-binary-cache-store-parallel-compression)</span>"
msgstr ""

#: source/store/types/http-binary-cache-store.md:60
msgid ""
"Enable multi-threaded compression of NARs. This is currently only available "
"for `xz` and `zstd`."
msgstr ""

#: source/store/types/http-binary-cache-store.md:62
msgid ""
"If not set explicitly, defaults to `true` when `compression` is `zstd` and "
"`false` otherwise."
msgstr ""

#: source/store/types/http-binary-cache-store.md:66
msgid ""
"<span id=\"store-http-binary-cache-store-path-info-cache-size\">[`path-info-"
"cache-size`](#store-http-binary-cache-store-path-info-cache-size)</span>"
msgstr ""

#: source/store/types/http-binary-cache-store.md:68
msgid "Size of the in-memory store path metadata cache."
msgstr ""

#: source/store/types/http-binary-cache-store.md:70
msgid "**Default:** `65536`"
msgstr ""

#: source/store/types/http-binary-cache-store.md:72
msgid ""
"<span id=\"store-http-binary-cache-store-priority\">[`priority`](#store-http-"
"binary-cache-store-priority)</span>"
msgstr ""

#: source/store/types/http-binary-cache-store.md:74
msgid ""
"Priority of this store when used as a [substituter](../../command-ref/conf-"
"file.md#conf-substituters). A lower value means a higher priority."
msgstr ""

#: source/store/types/http-binary-cache-store.md:77
#: source/store/types/http-binary-cache-store.md:83
#: source/store/types/http-binary-cache-store.md:89
#: source/store/types/http-binary-cache-store.md:95
#: source/store/types/http-binary-cache-store.md:101
msgid "**Default:** `0`"
msgstr ""

#: source/store/types/http-binary-cache-store.md:79
msgid ""
"<span id=\"store-http-binary-cache-store-retry-attempts\">[`retry-attempts`]"
"(#store-http-binary-cache-store-retry-attempts)</span>"
msgstr ""

#: source/store/types/http-binary-cache-store.md:81
msgid ""
"Override [`filetransfer-retry-attempts`](../../command-ref/conf-file.md#conf-"
"filetransfer-retry-attempts) for requests to this store."
msgstr ""

#: source/store/types/http-binary-cache-store.md:85
msgid ""
"<span id=\"store-http-binary-cache-store-retry-delay\">[`retry-delay`]"
"(#store-http-binary-cache-store-retry-delay)</span>"
msgstr ""

#: source/store/types/http-binary-cache-store.md:87
msgid ""
"Override [`filetransfer-retry-delay`](../../command-ref/conf-file.md#conf-"
"filetransfer-retry-delay) for requests to this store (milliseconds)."
msgstr ""

#: source/store/types/http-binary-cache-store.md:91
msgid ""
"<span id=\"store-http-binary-cache-store-retry-delay-rate-limited\">[`retry-"
"delay-rate-limited`](#store-http-binary-cache-store-retry-delay-rate-"
"limited)</span>"
msgstr ""

#: source/store/types/http-binary-cache-store.md:93
msgid ""
"Override [`filetransfer-retry-delay-rate-limited`](../../command-ref/conf-"
"file.md#conf-filetransfer-retry-delay-rate-limited) for requests to this "
"store (milliseconds)."
msgstr ""

#: source/store/types/http-binary-cache-store.md:97
msgid ""
"<span id=\"store-http-binary-cache-store-retry-max-delay\">[`retry-max-"
"delay`](#store-http-binary-cache-store-retry-max-delay)</span>"
msgstr ""

#: source/store/types/http-binary-cache-store.md:99
msgid ""
"Override [`filetransfer-retry-max-delay`](../../command-ref/conf-file."
"md#conf-filetransfer-retry-max-delay) for requests to this store "
"(milliseconds)."
msgstr ""

#: source/store/types/http-binary-cache-store.md:103
msgid ""
"<span id=\"store-http-binary-cache-store-secret-key\">[`secret-key`](#store-"
"http-binary-cache-store-secret-key)</span>"
msgstr ""

#: source/store/types/http-binary-cache-store.md:105
msgid "Path to the secret key used to sign the binary cache."
msgstr ""

#: source/store/types/http-binary-cache-store.md:109
msgid ""
"<span id=\"store-http-binary-cache-store-secret-keys\">[`secret-keys`]"
"(#store-http-binary-cache-store-secret-keys)</span>"
msgstr ""

#: source/store/types/http-binary-cache-store.md:111
msgid ""
"List of comma-separated paths to the secret keys used to sign the binary "
"cache."
msgstr ""

#: source/store/types/http-binary-cache-store.md:113
msgid "**Default:** _empty_"
msgstr ""

#: source/store/types/http-binary-cache-store.md:115
msgid ""
"<span id=\"store-http-binary-cache-store-store\">[`store`](#store-http-"
"binary-cache-store-store)</span>"
msgstr ""

#: source/store/types/http-binary-cache-store.md:117
msgid "Logical location of the Nix store, usually `/nix/store`."
msgstr ""

#: source/store/types/http-binary-cache-store.md:119
msgid ""
"Defaults to [`NIX_STORE_DIR`](../../command-ref/env-common.md#env-"
"NIX_STORE_DIR) if unset."
msgstr ""

#: source/store/types/http-binary-cache-store.md:121
msgid ""
"Note that you can only copy store paths between stores if they have the same "
"`store` setting."
msgstr ""

#: source/store/types/http-binary-cache-store.md:123
msgid "**Default:** `/nix/store`"
msgstr ""

#: source/store/types/http-binary-cache-store.md:125
msgid ""
"<span id=\"store-http-binary-cache-store-system-features\">[`system-"
"features`](#store-http-binary-cache-store-system-features)</span>"
msgstr ""

#: source/store/types/http-binary-cache-store.md:127
msgid ""
"Optional [system features](../../command-ref/conf-file.md#conf-system-"
"features) available on the system this store uses to build derivations."
msgstr ""

#: source/store/types/http-binary-cache-store.md:129
msgid "Example: `\"kvm\"`"
msgstr ""

#: source/store/types/http-binary-cache-store.md:131
msgid "**Default:** _machine-specific_"
msgstr ""

#: source/store/types/http-binary-cache-store.md:133
msgid ""
"<span id=\"store-http-binary-cache-store-tls-certificate\">[`tls-"
"certificate`](#store-http-binary-cache-store-tls-certificate)</span>"
msgstr ""

#: source/store/types/http-binary-cache-store.md:135
msgid "Path to an optional TLS client certificate in PEM format."
msgstr ""

#: source/store/types/http-binary-cache-store.md:139
msgid ""
"<span id=\"store-http-binary-cache-store-tls-private-key\">[`tls-private-"
"key`](#store-http-binary-cache-store-tls-private-key)</span>"
msgstr ""

#: source/store/types/http-binary-cache-store.md:141
msgid "Path to an optional TLS client certificate private key in PEM format."
msgstr ""

#: source/store/types/http-binary-cache-store.md:145
msgid ""
"<span id=\"store-http-binary-cache-store-trusted\">[`trusted`](#store-http-"
"binary-cache-store-trusted)</span>"
msgstr ""

#: source/store/types/http-binary-cache-store.md:147
msgid ""
"Whether paths from this store can be used as substitutes even if they are "
"not signed by a key listed in the [`trusted-public-keys`](../../command-ref/"
"conf-file.md#conf-trusted-public-keys) setting."
msgstr ""

#: source/store/types/http-binary-cache-store.md:154
msgid ""
"<span id=\"store-http-binary-cache-store-want-mass-query\">[`want-mass-"
"query`](#store-http-binary-cache-store-want-mass-query)</span>"
msgstr ""

#: source/store/types/http-binary-cache-store.md:156
msgid ""
"Whether this store can be queried efficiently for path validity when used as "
"a [substituter](../../command-ref/conf-file.md#conf-substituters)."
msgstr ""

#: source/store/types/http-binary-cache-store.md:160
msgid ""
"<span id=\"store-http-binary-cache-store-write-nar-listing\">[`write-nar-"
"listing`](#store-http-binary-cache-store-write-nar-listing)</span>"
msgstr ""

#: source/store/types/http-binary-cache-store.md:162
msgid "Whether to write a JSON file that lists the files in each NAR."
msgstr ""
