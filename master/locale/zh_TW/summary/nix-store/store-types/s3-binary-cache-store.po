#: source/store/types/s3-binary-cache-store.md:303
#: source/store/types/s3-binary-cache-store.md:327
#: source/store/types/s3-binary-cache-store.md:333
msgid "**Default:** \\``"
msgstr ""

#: source/store/types/s3-binary-cache-store.md:155
msgid ""
"<span id=\"store-s3-binary-cache-store-log-compression\">[`log-compression`]"
"(#store-s3-binary-cache-store-log-compression)</span>"
msgstr ""

#: source/store/types/s3-binary-cache-store.md:157
msgid ""
"Compression method for `log/*` files. It is recommended to use a compression "
"method supported by most web browsers (e.g. `brotli`)."
msgstr ""

#: source/store/types/s3-binary-cache-store.md:163
msgid ""
"<span id=\"store-s3-binary-cache-store-ls-compression\">[`ls-compression`]"
"(#store-s3-binary-cache-store-ls-compression)</span>"
msgstr ""

#: source/store/types/s3-binary-cache-store.md:165
msgid "Compression method for `.ls` files."
msgstr ""

#: source/store/types/s3-binary-cache-store.md:169
msgid ""
"<span id=\"store-s3-binary-cache-store-multipart-chunk-size\">[`multipart-"
"chunk-size`](#store-s3-binary-cache-store-multipart-chunk-size)</span>"
msgstr ""

#: source/store/types/s3-binary-cache-store.md:171
msgid ""
"The size (in bytes) of each part in multipart uploads. Must be at least 5 "
"MiB (AWS S3 requirement). Larger chunk sizes reduce the number of requests "
"but use more memory. Default is 5 MiB."
msgstr ""

#: source/store/types/s3-binary-cache-store.md:175
msgid "**Default:** `5242880`"
msgstr ""

#: source/store/types/s3-binary-cache-store.md:177
msgid "**Deprecated alias:** `buffer-size`"
msgstr ""

#: source/store/types/s3-binary-cache-store.md:179
msgid ""
"<span id=\"store-s3-binary-cache-store-multipart-threshold\">[`multipart-"
"threshold`](#store-s3-binary-cache-store-multipart-threshold)</span>"
msgstr ""

#: source/store/types/s3-binary-cache-store.md:181
msgid ""
"The minimum file size (in bytes) for using multipart uploads. Files smaller "
"than this threshold will use regular PUT requests. Default is 100 MiB. Only "
"takes effect when multipart-upload is enabled."
msgstr ""

#: source/store/types/s3-binary-cache-store.md:185
msgid "**Default:** `104857600`"
msgstr ""

#: source/store/types/s3-binary-cache-store.md:187
msgid ""
"<span id=\"store-s3-binary-cache-store-multipart-upload\">[`multipart-"
"upload`](#store-s3-binary-cache-store-multipart-upload)</span>"
msgstr ""

#: source/store/types/s3-binary-cache-store.md:189
msgid ""
"Whether to use multipart uploads for large files. When enabled, files "
"exceeding the multipart threshold will be uploaded in multiple parts, which "
"is required for files larger than 5 GiB and can improve performance and "
"reliability for large uploads."
msgstr ""

#: source/store/types/s3-binary-cache-store.md:196
msgid ""
"<span id=\"store-s3-binary-cache-store-narinfo-compression\">[`narinfo-"
"compression`](#store-s3-binary-cache-store-narinfo-compression)</span>"
msgstr ""

#: source/store/types/s3-binary-cache-store.md:198
msgid "Compression method for `.narinfo` files."
msgstr ""

#: source/store/types/s3-binary-cache-store.md:202
msgid ""
"<span id=\"store-s3-binary-cache-store-parallel-compression\">[`parallel-"
"compression`](#store-s3-binary-cache-store-parallel-compression)</span>"
msgstr ""

#: source/store/types/s3-binary-cache-store.md:204
msgid ""
"Enable multi-threaded compression of NARs. This is currently only available "
"for `xz` and `zstd`."
msgstr ""

#: source/store/types/s3-binary-cache-store.md:206
msgid ""
"If not set explicitly, defaults to `true` when `compression` is `zstd` and "
"`false` otherwise."
msgstr ""

#: source/store/types/s3-binary-cache-store.md:210
msgid ""
"<span id=\"store-s3-binary-cache-store-path-info-cache-size\">[`path-info-"
"cache-size`](#store-s3-binary-cache-store-path-info-cache-size)</span>"
msgstr ""

#: source/store/types/s3-binary-cache-store.md:212
msgid "Size of the in-memory store path metadata cache."
msgstr ""

#: source/store/types/s3-binary-cache-store.md:214
msgid "**Default:** `65536`"
msgstr ""

#: source/store/types/s3-binary-cache-store.md:216
msgid ""
"<span id=\"store-s3-binary-cache-store-priority\">[`priority`](#store-s3-"
"binary-cache-store-priority)</span>"
msgstr ""

#: source/store/types/s3-binary-cache-store.md:218
msgid ""
"Priority of this store when used as a [substituter](../../command-ref/conf-"
"file.md#conf-substituters). A lower value means a higher priority."
msgstr ""

#: source/store/types/s3-binary-cache-store.md:221
#: source/store/types/s3-binary-cache-store.md:242
#: source/store/types/s3-binary-cache-store.md:248
#: source/store/types/s3-binary-cache-store.md:254
#: source/store/types/s3-binary-cache-store.md:260
msgid "**Default:** `0`"
msgstr ""

#: source/store/types/s3-binary-cache-store.md:223
msgid ""
"<span id=\"store-s3-binary-cache-store-profile\">[`profile`](#store-s3-"
"binary-cache-store-profile)</span>"
msgstr ""

#: source/store/types/s3-binary-cache-store.md:225
msgid ""
"The name of the AWS configuration profile to use. By default Nix uses the "
"`default` profile."
msgstr ""

#: source/store/types/s3-binary-cache-store.md:228
msgid "**Default:** `default`"
msgstr ""

#: source/store/types/s3-binary-cache-store.md:230
msgid ""
"<span id=\"store-s3-binary-cache-store-region\">[`region`](#store-s3-binary-"
"cache-store-region)</span>"
msgstr ""

#: source/store/types/s3-binary-cache-store.md:232
msgid ""
"The region of the S3 bucket. If your bucket is not in `us-east-1`, you "
"should always explicitly specify the region parameter."
msgstr ""

#: source/store/types/s3-binary-cache-store.md:236
msgid "**Default:** `us-east-1`"
msgstr ""

#: source/store/types/s3-binary-cache-store.md:238
msgid ""
"<span id=\"store-s3-binary-cache-store-retry-attempts\">[`retry-attempts`]"
"(#store-s3-binary-cache-store-retry-attempts)</span>"
msgstr ""

#: source/store/types/s3-binary-cache-store.md:240
msgid ""
"Override [`filetransfer-retry-attempts`](../../command-ref/conf-file.md#conf-"
"filetransfer-retry-attempts) for requests to this store."
msgstr ""

#: source/store/types/s3-binary-cache-store.md:244
msgid ""
"<span id=\"store-s3-binary-cache-store-retry-delay\">[`retry-delay`](#store-"
"s3-binary-cache-store-retry-delay)</span>"
msgstr ""

#: source/store/types/s3-binary-cache-store.md:246
msgid ""
"Override [`filetransfer-retry-delay`](../../command-ref/conf-file.md#conf-"
"filetransfer-retry-delay) for requests to this store (milliseconds)."
msgstr ""

#: source/store/types/s3-binary-cache-store.md:250
msgid ""
"<span id=\"store-s3-binary-cache-store-retry-delay-rate-limited\">[`retry-"
"delay-rate-limited`](#store-s3-binary-cache-store-retry-delay-rate-limited)</"
"span>"
msgstr ""

#: source/store/types/s3-binary-cache-store.md:252
msgid ""
"Override [`filetransfer-retry-delay-rate-limited`](../../command-ref/conf-"
"file.md#conf-filetransfer-retry-delay-rate-limited) for requests to this "
"store (milliseconds)."
msgstr ""

#: source/store/types/s3-binary-cache-store.md:256
msgid ""
"<span id=\"store-s3-binary-cache-store-retry-max-delay\">[`retry-max-delay`]"
"(#store-s3-binary-cache-store-retry-max-delay)</span>"
msgstr ""

#: source/store/types/s3-binary-cache-store.md:258
msgid ""
"Override [`filetransfer-retry-max-delay`](../../command-ref/conf-"
"file.md#conf-filetransfer-retry-max-delay) for requests to this store "
"(milliseconds)."
msgstr ""

#: source/store/types/s3-binary-cache-store.md:262
msgid ""
"<span id=\"store-s3-binary-cache-store-scheme\">[`scheme`](#store-s3-binary-"
"cache-store-scheme)</span>"
msgstr ""

#: source/store/types/s3-binary-cache-store.md:264
msgid ""
"The scheme used for S3 requests, `https` (default) or `http`. This option "
"allows you to disable HTTPS for binary caches which don't support it."
msgstr ""

#: source/store/types/s3-binary-cache-store.md:268
msgid "**Note**"
msgstr ""

#: source/store/types/s3-binary-cache-store.md:270
msgid "HTTPS should be used if the cache might contain sensitive information."
msgstr ""

#: source/store/types/s3-binary-cache-store.md:273
msgid "**Default:** `https`"
msgstr ""

#: source/store/types/s3-binary-cache-store.md:275
msgid ""
"<span id=\"store-s3-binary-cache-store-secret-key\">[`secret-key`](#store-s3-"
"binary-cache-store-secret-key)</span>"
msgstr ""

#: source/store/types/s3-binary-cache-store.md:277
msgid "Path to the secret key used to sign the binary cache."
msgstr ""

#: source/store/types/s3-binary-cache-store.md:281
msgid ""
"<span id=\"store-s3-binary-cache-store-secret-keys\">[`secret-keys`](#store-"
"s3-binary-cache-store-secret-keys)</span>"
msgstr ""

#: source/store/types/s3-binary-cache-store.md:283
msgid ""
"List of comma-separated paths to the secret keys used to sign the binary "
"cache."
msgstr ""

#: source/store/types/s3-binary-cache-store.md:287
msgid ""
"<span id=\"store-s3-binary-cache-store-storage-class\">[`storage-class`]"
"(#store-s3-binary-cache-store-storage-class)</span>"
msgstr ""

#: source/store/types/s3-binary-cache-store.md:289
msgid ""
"The S3 storage class to use for uploaded objects. When not set (default), "
"uses the bucket's default storage class. Valid values include:"
msgstr ""

#: source/store/types/s3-binary-cache-store.md:291
msgid "STANDARD (default, frequently accessed data)"
msgstr ""

#: source/store/types/s3-binary-cache-store.md:292
msgid "REDUCED_REDUNDANCY (less frequently accessed data)"
msgstr ""

#: source/store/types/s3-binary-cache-store.md:293
msgid "STANDARD_IA (infrequent access)"
msgstr ""

#: source/store/types/s3-binary-cache-store.md:294
msgid "ONEZONE_IA (infrequent access, single AZ)"
msgstr ""

#: source/store/types/s3-binary-cache-store.md:295
msgid "INTELLIGENT_TIERING (automatic cost optimization)"
msgstr ""

#: source/store/types/s3-binary-cache-store.md:296
msgid "GLACIER (archival with retrieval times in minutes to hours)"
msgstr ""

#: source/store/types/s3-binary-cache-store.md:297
msgid "DEEP_ARCHIVE (long-term archival with 12-hour retrieval)"
msgstr ""

#: source/store/types/s3-binary-cache-store.md:298
msgid "GLACIER_IR (instant retrieval archival)"
msgstr ""

#: source/store/types/s3-binary-cache-store.md:300
msgid ""
"See AWS S3 documentation for detailed storage class descriptions and "
"pricing: https://docs.aws.amazon.com/AmazonS3/latest/userguide/storage-class-"
"intro.html"
msgstr ""

#: source/store/types/s3-binary-cache-store.md:305
msgid ""
"<span id=\"store-s3-binary-cache-store-store\">[`store`](#store-s3-binary-"
"cache-store-store)</span>"
msgstr ""

#: source/store/types/s3-binary-cache-store.md:307
msgid "Logical location of the Nix store, usually `/nix/store`."
msgstr ""

#: source/store/types/s3-binary-cache-store.md:309
msgid ""
"Defaults to [`NIX_STORE_DIR`](../../command-ref/env-common.md#env-"
"NIX_STORE_DIR) if unset."
msgstr ""

