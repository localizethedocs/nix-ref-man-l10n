msgstr ""

#: source/command-ref/new-cli/nix3-store-ls.md:6
msgid "Name"
msgstr ""

#: source/command-ref/new-cli/nix3-store-ls.md:8
msgid "`nix store ls` - show information about a path in the Nix store"
msgstr ""

#: source/command-ref/new-cli/nix3-store-ls.md:10
msgid "Synopsis"
msgstr "概要"

#: source/command-ref/new-cli/nix3-store-ls.md:12
msgid "`nix store ls` \\[_option_...\\] _path_"
msgstr ""

#: source/command-ref/new-cli/nix3-store-ls.md:14
msgid "Examples"
msgstr ""

#: source/command-ref/new-cli/nix3-store-ls.md:16
msgid "To list the contents of a store path in a binary cache:"
msgstr ""

#: source/command-ref/new-cli/nix3-store-ls.md:18
msgid ""
"```console\n"
"# nix store ls --store https://cache.nixos.org/ --long --recursive /nix/"
"store/qbhyj3blxpw2i6pb7c6grc9185nbnpvy-hello-2.10\n"
"dr-xr-xr-x                    0 ./bin\n"
"-r-xr-xr-x                38184 ./bin/hello\n"
"dr-xr-xr-x                    0 ./share\n"
"…\n"
"```"
msgstr ""

#: source/command-ref/new-cli/nix3-store-ls.md:26
msgid "To show information about a specific file in a binary cache:"
msgstr ""

#: source/command-ref/new-cli/nix3-store-ls.md:28
msgid ""
"```console\n"
"# nix store ls --store https://cache.nixos.org/ --long /nix/store/"
"qbhyj3blxpw2i6pb7c6grc9185nbnpvy-hello-2.10/bin/hello\n"
"-r-xr-xr-x                38184 hello\n"
"```"
msgstr ""

#: source/command-ref/new-cli/nix3-store-ls.md:33
msgid "Description"
msgstr ""

#: source/command-ref/new-cli/nix3-store-ls.md:35
msgid ""
"This command shows information about _path_ in a Nix store. _path_ can be a "
"top-level store path or any file inside a store path."
msgstr ""

