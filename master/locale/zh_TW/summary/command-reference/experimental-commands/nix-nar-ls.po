msgid ""
"**Warning**   \n"
"This program is [**experimental**](../../development/experimental-"
"features.md#xp-feature-nix-command) and its interface is subject to change."
msgstr ""

#: source/command-ref/new-cli/nix3-nar-ls.md:6
msgid "Name"
msgstr ""

#: source/command-ref/new-cli/nix3-nar-ls.md:8
msgid "`nix nar ls` - show information about a path inside a NAR file"
msgstr ""

#: source/command-ref/new-cli/nix3-nar-ls.md:10
msgid "Synopsis"
msgstr "概要"

#: source/command-ref/new-cli/nix3-nar-ls.md:12
msgid "`nix nar ls` \\[_option_...\\] _nar_ _path_"
msgstr ""

#: source/command-ref/new-cli/nix3-nar-ls.md:14
msgid "Examples"
msgstr ""

#: source/command-ref/new-cli/nix3-nar-ls.md:16
msgid ""
"To list a specific file in a [NAR](../../store/file-system-object/content-"
"address.md#serial-nix-archive):"
msgstr ""

#: source/command-ref/new-cli/nix3-nar-ls.md:23
msgid ""
"To recursively list the contents of a directory inside a NAR, in JSON format:"
msgstr ""

#: source/command-ref/new-cli/nix3-nar-ls.md:26
msgid ""
"```console\n"
"# nix nar ls --json --recursive ./hello.nar /bin\n"
"{\"type\":\"directory\",\"entries\":{\"hello\":{\"type\":\"regular\","
"\"size\":38184,\"executable\":true,\"narOffset\":400}}}\n"
"```"
msgstr ""

#: source/command-ref/new-cli/nix3-nar-ls.md:31
msgid "Description"
msgstr ""

#: source/command-ref/new-cli/nix3-nar-ls.md:33
msgid ""
"This command shows information about a _path_ inside [Nix Archive (NAR)]"
"(../../store/file-system-object/content-address.md#serial-nix-archive) file "
"_nar_."
msgstr ""

