#: source/command-ref/new-cli/nix.md:367
msgid ""
"````\n"
"#!/usr/bin/env nix\n"
"//! ```cargo\n"
"//! [dependencies]\n"
"//! time = \"0.1.25\"\n"
"//! ```\n"
"/*\n"
