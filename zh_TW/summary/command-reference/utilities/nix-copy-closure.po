msgid "Examples"
msgstr ""

#: source/command-ref/nix-copy-closure.md:499
msgid "Copy GNU Hello with all its dependencies to a remote machine:"
msgstr ""

#: source/command-ref/nix-copy-closure.md:501
msgid ""
"```shell-session\n"
"$ storePath=\"$(nix-build '<nixpkgs>' -I nixpkgs=channel:nixpkgs-unstable -A "
"hello --no-out-link)\"\n"
"$ nix-copy-closure --to alice@itchy.example.org \"$storePath\"\n"
"copying 5 paths...\n"
"copying path '/nix/store/h6q8sqsqfbd3252f9gixqn3z282wds7m-xgcc-13.2.0-"
"libgcc' to 'ssh://alice@itchy.example.org'...\n"
"copying path '/nix/store/imnwvn96lw355giswsk36hx105j4wnpj-libunistring-1.1' "
"to 'ssh://alice@itchy.example.org'...\n"
"copying path '/nix/store/85301indj7scg34spnfczkz72jgv8wa9-libidn2-2.3.7' to "
"'ssh://alice@itchy.example.org'...\n"
"copying path '/nix/store/ypwfsaljwhzw9iffiysxmxnhjj8v7np0-glibc-2.39-31' to "
"'ssh://alice@itchy.example.org'...\n"
"copying path '/nix/store/0dklv59zppdsqdvgf0qdvjgzcs5wbwxa-hello-2.12.1' to "
"'ssh://alice@itchy.example.org'...\n"
"```"
msgstr ""

#: source/command-ref/nix-copy-closure.md:514
msgid ""
"Copy GNU Hello from a remote machine using a known store path, and run it:"
msgstr ""

#: source/command-ref/nix-copy-closure.md:516
msgid ""
"```shell-session\n"
"$ storePath=\"$(nix-instantiate --eval --raw '<nixpkgs>' -I nixpkgs=channel:"
"nixpkgs-unstable -A hello.outPath)\"\n"
"$ nix-copy-closure --from alice@itchy.example.org \"$storePath\"\n"
"$ \"$storePath\"/bin/hello\n"
"Hello, world!\n"
"```"
msgstr ""
