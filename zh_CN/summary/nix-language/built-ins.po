msgstr ""

#: source/language/builtins.md:2676
msgid ""
"```nix\n"
"builtins.split \"([ac])\" \"abc\"\n"
"```"
msgstr ""

#: source/language/builtins.md:2680
msgid "Evaluates to `[ \"\" [ \"a\" ] \"b\" [ \"c\" ] \"\" ]`."
