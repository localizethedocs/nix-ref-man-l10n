msgid ""
"In case of duplicate occurrences of the same name, the first takes "
"precedence."
msgstr ""

#: source/language/builtins.md:2114
msgid ""
"```nix\n"
"builtins.listToAttrs\n"
"  [ { name = \"foo\"; value = 123; }\n"
"    { name = \"bar\"; value = 456; }\n"
"    { name = \"bar\"; value = 420; }\n"
"  ]\n"
"```"
msgstr ""

