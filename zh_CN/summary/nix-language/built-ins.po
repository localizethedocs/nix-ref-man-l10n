#: source/language/builtins.md:2187
msgid ""
"```nix\n"
"builtins.match \"abc\" \"abc\"\n"
"```"
msgstr ""

#: source/language/builtins.md:2191
msgid "Evaluates to `[ ]`."
msgstr ""

#: source/language/builtins.md:2193
msgid ""
"```nix\n"
"builtins.match \"a(b)(c)\" \"abc\"\n"
"```"
msgstr ""

#: source/language/builtins.md:2197
msgid "Evaluates to `[ \"b\" \"c\" ]`."
msgstr ""

#: source/language/builtins.md:2199
