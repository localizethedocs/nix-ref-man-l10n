#: source/command-ref/nix-channel.md:544
msgid ""
"Subscribe to the Nixpkgs channel and run `hello` from the GNU Hello package:"
msgstr ""

#: source/command-ref/nix-channel.md:546
msgid ""
"```console\n"
"$ nix-channel --add https://channels.nixos.org/nixpkgs-unstable\n"
"$ nix-channel --list\n"
"nixpkgs https://channels.nixos.org/nixpkgs\n"
"$ nix-channel --update\n"
"$ nix-shell -p hello --run hello\n"
"hello\n"
"```"
msgstr ""

#: source/command-ref/nix-channel.md:555
msgid "Revert channel updates using `--rollback`:"
msgstr ""

#: source/command-ref/nix-channel.md:557
msgid ""
"```console\n"
"$ nix-instantiate --eval '<nixpkgs>' --attr lib.version\n"
"\"22.11pre296212.530a53dcbc9\"\n"
"\n"
"$ nix-channel --rollback\n"
"switching from generation 483 to 482\n"
"\n"
"$ nix-instantiate --eval '<nixpkgs>' --attr lib.version\n"
"\"22.11pre281526.d0419badfad\"\n"
"```"
msgstr ""

