msgid "[Flat](../store/store-object/content-address.md#method-flat)"
msgstr ""

#: source/protocols/derivation-aterm.md:132
msgid "`r:`"
msgstr ""

#: source/protocols/derivation-aterm.md:132
msgid ""
"[Nix Archive](../store/store-object/content-address.md#method-nix-archive)"
msgstr ""

#: source/protocols/derivation-aterm.md:133
msgid "`text:`"
msgstr ""

#: source/protocols/derivation-aterm.md:133
msgid "[Text](../store/store-object/content-address.md#method-text)"
msgstr ""

